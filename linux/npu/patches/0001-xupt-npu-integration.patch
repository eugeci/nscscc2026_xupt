diff --git a/drivers/misc/Kconfig b/drivers/misc/Kconfig
index 0f5a49fc7c9e..4566f097c1f5 100644
--- a/drivers/misc/Kconfig
+++ b/drivers/misc/Kconfig
@@ -470,6 +470,17 @@ config XILINX_SDFEC
 
 	  If unsure, say N.
 
+config XUPT_NPU
+	tristate "XUPT Chiplab neural-network accelerator"
+	depends on OF && HAS_IOMEM
+	help
+	  Enable the platform driver for the neural-network accelerator used
+	  by the XUPT Chiplab SoC.  The driver exposes /dev/xupt-npu and
+	  supports frame upload, programmable layer descriptors, interrupt
+	  driven execution and bounding-box result retrieval.
+
+	  If unsure, say N.
+
 config MISC_RTSX
 	tristate
 	default MISC_RTSX_PCI || MISC_RTSX_USB
