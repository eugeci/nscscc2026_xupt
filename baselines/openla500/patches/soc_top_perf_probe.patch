--- soc_top.v
+++ soc_top.v
@@ -93,6 +93,9 @@ module soc_top #(parameter SIMULATION=1'b0)
 );
 
 wire [31:0] num_data;
+wire [31:0] perf_instret_count_cpu;
+(* ASYNC_REG = "TRUE" *) reg [31:0] perf_instret_sync1;
+(* ASYNC_REG = "TRUE" *) reg [31:0] perf_instret_count;
 wire resetn_vio;
 wire resetn;
 wire [7:0] switch_vio;
@@ -117,7 +120,14 @@ vio_0 vio (
         .probe_out1(switch_vio),
         .probe_out2(btn_step_vio),
