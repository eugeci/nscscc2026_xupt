+        .probe_in1 (perf_instret_count),
         .probe_in2 (led_rg0 ),
         .probe_in3 (led_rg1 )
     );
+
+// The counter stops long before JTAG reads it. Two stages in the VIO clock
+// domain provide a stable, coherent sample without timing the CPU-to-VIO CDC.
+always @(posedge clk) begin
+    perf_instret_sync1 <= perf_instret_count_cpu;
+    perf_instret_count <= perf_instret_sync1;
+end
